# Configurações da API Loja Integrada
# Opção 1: Usando Personal Token (Recomendado)
LI_PERSONAL_TOKEN=seu_personal_token_aqui

# Opção 2: Usando Chaves Legadas (Caso não use Personal Token)
LI_CHAVE_API=
LI_CHAVE_APLICACAO=

# Configurações da OpenAI (ChatGPT)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Regras de Negócio e Atualização
# Quais campos você deseja que o GPT gere e atualize? (true/false)
UPDATE_SEO_TITLE=true
UPDATE_SEO_DESCRIPTION=true
UPDATE_SEO_KEYWORDS=true
UPDATE_DESCRIPTION_HTML=false

# Filtrar apenas produtos com pendências?
# Se true: só processa produtos que não possuem descrição ou que estão sem meta description SEO
ONLY_MISSING_SEO_OR_DESC=true

# Apenas produtos ativos na loja? (true/false)
ONLY_ACTIVE_PRODUCTS=true

# Limite máximo de produtos para processar por execução (0 = todos)
PRODUCT_LIMIT=20

# Segurança contra execução acidental:
# Se true, simula todo o processo e gera os arquivos sem enviar alterações para a Loja Integrada
DRY_RUN=false

# Informações da Loja (usadas no SEO e links de tags na descrição)
STORE_NAME=StoreName
STORE_URL=https://www.storename.com.br

# Taxa de requisições: intervalo em segundos entre chamadas da LI para respeitar limite (100 req/min)
LI_REQUEST_DELAY=0.8
